# Ghost環境変数（テンプレート）
#
# 使い方:
# 1. 開発環境用: .env.development をコピーして .env を作成
# 2. 本番環境用: .env.production を使用（deploy.shが自動で使用）
#
# 重要：.env ファイルは.gitignoreに含まれており、Gitにコミットされません

# ドメイン設定
GHOST_URL=https://yourdomain.com

# データベース設定
DB_NAME=ghostdb
DB_USER=ghost
DB_PASSWORD=your_strong_password_here_change_this
DB_ROOT_PASSWORD=your_strong_root_password_here_change_this

# メール設定（オプション - Ghost通知用）
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
